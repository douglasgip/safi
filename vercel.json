{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/resumocontabil", "destination": "/Grupo%20Sacoman%20-%20Painel%20Cont%C3%A1bil.dc.html" },
    { "source": "/dre", "destination": "/Grupo%20Sacoman%20-%20Painel%20Cont%C3%A1bil.dc.html" },
    { "source": "/geronia", "destination": "/geronia.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/mapa-societario", "destination": "/mapa-societario.html" },
    { "source": "/funcionarios", "destination": "/funcionarios.html" },
    { "source": "/lancamentos", "destination": "/lancamentos.html" },
    { "source": "/calculadora-importacao", "destination": "/calculadora-importacao.html" },
    { "source": "/conselho", "destination": "/conselho.html" },
    { "source": "/orcamento", "destination": "/orcamento.html" },
    { "source": "/tesouraria", "destination": "/tesouraria.html" },
    { "source": "/reunioes", "destination": "/reunioes.html" },
    { "source": "/geraudio", "destination": "/geraudio.html" }
  ],
  "redirects": [
    { "source": "/fluxo-caixa", "destination": "/", "permanent": false },
    { "source": "/pedidos", "destination": "/", "permanent": false },
    { "source": "/despesas-fixas", "destination": "/", "permanent": false },
    { "source": "/conciliacao", "destination": "/", "permanent": false },
    { "source": "/fechamento", "destination": "/", "permanent": false },
    { "source": "/plano-orcamentario", "destination": "/", "permanent": false },
    { "source": "/produtos", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
