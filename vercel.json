{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/resumocontabil", "destination": "/Grupo%20Sacoman%20-%20Painel%20Cont%C3%A1bil.dc.html" },
    { "source": "/dre", "destination": "/Grupo%20Sacoman%20-%20Painel%20Cont%C3%A1bil.dc.html" },
    { "source": "/geronia", "destination": "/geronia.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/mapa-societario", "destination": "/mapa-societario.html" },
    { "source": "/funcionarios", "destination": "/funcionarios.html" },
    { "source": "/fluxo-caixa", "destination": "/fluxo-caixa.html" },
    { "source": "/lancamentos", "destination": "/lancamentos.html" },
    { "source": "/pedidos", "destination": "/pedidos.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
